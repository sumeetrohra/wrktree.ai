rules_version = '2';
// Agentdeck: every account's data lives under users/{uid}, readable and writable only by that
// signed-in user (any of their devices: hosts write chats, consumers read them).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
