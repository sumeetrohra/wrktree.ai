# Agentdeck: relay + daemon/CLI settings. Copy to `.env` (never commit it):
#   cp .env.example .env
# `pnpm relay` and `pnpm agentdeck …` load it. The app has its own file: apps/mobile/.env.example.
# These defaults run the whole stack locally, with no accounts or keys.

# ─── Relay (apps/relay) ──────────────────────────────────────────────────────────────────────

# "1" = development: the relay mints its own sign-in tokens (GET /v1/dev/id-token) instead of
# needing Firebase, and records pushes instead of sending them. Never "1" in production.
RELAY_DEV=1
# Development only (RELAY_DEV=1): signs dev sign-in tokens. Any 32+ random characters.
RELAY_DEV_SECRET=change-me-to-32-or-more-random-characters
# Production: your Firebase project id (Firebase console → Project settings → General).
# Required unless RELAY_DEV=1. The relay only verifies Firebase ID tokens; it holds no secrets.
# FIREBASE_PROJECT_ID=my-agentdeck-project
# The relay's public base URL.
RELAY_PUBLIC_URL=http://127.0.0.1:8787
# Optional: Expo push access token, only if "enhanced push security" is on for your Expo project
# (expo.dev → Account settings → Access tokens).
# EXPO_ACCESS_TOKEN=
# Where the self-host relay listens and keeps its SQLite files.
PORT=8787
HOST=127.0.0.1
# RELAY_DATA_DIR=/var/lib/agentdeck-relay   # default: ~/.agentdeck-relay

# ─── Daemon and CLI (apps/daemon, apps/cli) ─────────────────────────────────────────────────

# The relay this computer joins. Overrides `agentdeck relay set <url>`. Unset = local only.
AGENTDECK_RELAY_URL=http://127.0.0.1:8787
# Where `agentdeck login` sends you to approve this computer (the web app's URL).
# Default: https://app.agentdeck.dev. Locally: the Expo web dev server.
AGENTDECK_APP_URL=http://localhost:8081
# This computer's name on your account. Default: the OS hostname.
# AGENTDECK_HOST_NAME=laptop
# The daemon's data folder (database, logs, identity, sealed relay token). Default: the OS's app
# data folder. Set a different one to run a second daemon (a second "computer") on one machine.
# AGENTDECK_HOME=/tmp/agentdeck-laptop
# Folders `repo add` may reach (":"-separated; ";" on Windows). Default: your home folder.
# AGENTDECK_BROWSE_ROOTS=/home/me/src
# Serve the app's web build as this computer's desktop UI (`agentdeck open`). Build it with
# `pnpm --filter @agentdeck/mobile export:web`, then point here at apps/mobile/dist.
# AGENTDECK_WEB_ROOT=/path/to/wrktree.ai/apps/mobile/dist
# "file" keeps the identity's sealing secret in a 0600 file instead of the OS keystore
# (headless machines, CI). Default: "os".
# AGENTDECK_KEYSTORE=file
# A fixed port for the local transport (the CLI finds it either way). Default: a free port.
# AGENTDECK_LOCAL_PORT=41234
# Port range for worktree preview servers. Default: 41000-41999.
# AGENTDECK_PORT_RANGE=41000-41999
# "1" registers the scripted `fake` agent (tests, demos, trying things without an agent account).
AGENTDECK_DEV_AGENTS=1
# Development only: extra browser origins allowed on the local transport (comma-separated).
# AGENTDECK_DEV_ORIGINS=http://localhost:8081
# "1" also logs to stderr (the log file is always written under AGENTDECK_HOME/logs).
# AGENTDECK_LOG_STDERR=1
