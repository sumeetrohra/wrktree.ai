{
  "name": "@agentdeck/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentdeck": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentdeck/daemon": "workspace:*",
    "@agentdeck/protocol": "workspace:*",
    "@agentdeck/shared": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
