{
  "name": "@agentdeck/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentdeck": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/shared/output/index.d.ts",
      "default": "./dist/shared/output/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentdeck/daemon": "workspace:*",
    "@agentdeck/protocol": "workspace:*",
    "@agentdeck/shared": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  }
}
