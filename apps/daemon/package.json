{
  "name": "@agentdeck/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentdeck-daemon": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@agentdeck/fake-agent": "workspace:*",
    "@agentdeck/protocol": "workspace:*",
    "@agentdeck/shared": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "13.0.3",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/picomatch": "4.0.3",
    "@types/ws": "8.18.2"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  }
}
