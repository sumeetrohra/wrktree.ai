# Agentdeck app settings. Copy to apps/mobile/.env (never commit it):
#   cp apps/mobile/.env.example apps/mobile/.env
# Expo inlines EXPO_PUBLIC_* at build time: restart `expo start` / rebuild after changing them.
# Nothing here is secret (it ships inside the app), but keep dev values out of production builds.

# The relay the app signs in through. Production: your relay's https URL.
# On a phone, use your computer's LAN address (e.g. http://192.168.1.20:8787), not 127.0.0.1.
EXPO_PUBLIC_RELAY_URL=http://127.0.0.1:8787

# "1" shows "Dev sign-in" (any user id, minted by a RELAY_DEV=1 relay). Never in production.
EXPO_PUBLIC_DEV_AUTH=1

# Production sign-in: your Firebase project's Web API key (Firebase console → Project settings →
# General → Web API key). Enables email-link sign-in. Enable "Email link (passwordless)" in
# Authentication → Sign-in method, and add the app's domain under Authorized domains.
# EXPO_PUBLIC_FIREBASE_API_KEY=

# Where the web app lives; email sign-in links come back to <this>/sign-in.
# Default: https://app.agentdeck.dev
# EXPO_PUBLIC_APP_URL=http://localhost:8081

# Development only: talk to one local daemon directly, without the relay. The token is in
# <AGENTDECK_HOME>/local-token; add the dev server's origin to AGENTDECK_DEV_ORIGINS.
# EXPO_PUBLIC_DAEMON_URL=ws://127.0.0.1:41234/v1/ws   # with AGENTDECK_LOCAL_PORT=41234
# EXPO_PUBLIC_DAEMON_TOKEN=
