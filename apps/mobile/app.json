{
  "expo": {
    "name": "Agentdeck",
    "slug": "agentdeck",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "agentdeck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.agentdeck.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Agentdeck uses the camera when you take a photo to attach to a message for the agent.",
        "NSPhotoLibraryUsageDescription": "Agentdeck attaches the images you pick to your messages to the agent."
      }
    },
    "android": {
      "package": "dev.agentdeck.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Agentdeck attaches the images you pick to your messages to the agent.",
          "cameraPermission": "Agentdeck uses the camera when you take a photo to attach to a message for the agent.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    },
    "description": "Drive the coding agents running on your computers from your phone: watch them work, approve what they do, review and ship.",
    "icon": "./assets/icon.png"
  }
}
