{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELAY_URL": "https://relay.agentdeck.dev",
        "EXPO_PUBLIC_APP_URL": "https://app.agentdeck.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./store/google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
