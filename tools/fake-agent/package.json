{
  "name": "@agentdeck/fake-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Scripted ACP agent for tests: deterministic, no tokens.",
  "type": "module",
  "bin": {
    "fake-acp-agent": "./dist/index.js",
    "fake-acp-login": "./dist/login.js"
  },
