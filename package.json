{
  "name": "agentdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "relay": "node --env-file-if-exists=.env apps/relay/dist/main.node.js",
    "agentdeck": "node --env-file-if-exists=.env apps/cli/dist/main.js",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test --filter=!@agentdeck/e2e",
    "test:e2e": "turbo run build && pnpm --filter @agentdeck/e2e test",
    "e2e:record": "turbo run build && pnpm --filter @agentdeck/mobile export:web && pnpm --filter @agentdeck/e2e record && pnpm --filter @agentdeck/e2e record:app",
    "prepare": "husky",
    "knip": "knip",
    "emulators": "firebase emulators:exec --config firebase/firebase.json --project demo-agentdeck",
    "test:e2e:app": "turbo run build && pnpm --filter @agentdeck/mobile export:web && APP_E2E=1 pnpm --filter @agentdeck/e2e exec vitest run src/app.test.ts",
    "release": "node tools/release/dist/index.js",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "firebase-tools": "15.33.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/ripgrep",
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "miniflare>undici": "7.29.1",
      "miniflare>sharp": "0.35.5",
      "get-uri>basic-ftp": "6.2.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  }
}
