{
  "name": "agentdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test --filter=!@agentdeck/e2e",
    "test:e2e": "turbo run build && pnpm --filter @agentdeck/e2e test",
    "e2e:record": "turbo run build && pnpm --filter @agentdeck/e2e record"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@vscode/ripgrep",
      "esbuild"
    ]
  }
}
